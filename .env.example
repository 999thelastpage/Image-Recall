# Copy to .env and fill in locally. Never commit .env.
# Variable names only — no real values belong in this file.

META_MODEL_API_KEY=
META_MODEL_API_BASE_URL=
# Optional. Default muse-spark-1.3. muse-spark-1.3-contributor is cheaper,
# but Meta may train on prompts and images sent to it: keep personal photos off it.
MUSE_MODEL=
# Optional: reach Muse through another host, for example
# MUSE_BASE_URL=https://openrouter.ai/api/v1 with MUSE_MODEL=meta/muse-spark-1.3
MUSE_BASE_URL=
MUSE_API_KEY=
# Optional, local testing only: a stand-in model for reranking. Leave empty to use Muse.
RERANK_BASE_URL=
RERANK_API_KEY=
RERANK_MODEL=
# Optional: backup for the AI check when the main model is not available.
BACKUP_RERANK_API_KEY=
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
BASETEN_API_KEY=
FIREWORKS_API_KEY=
HF_TOKEN=
